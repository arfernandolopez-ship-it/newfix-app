# NEWFIX — Variables de entorno
# Renombrá este archivo a .env.local y completá los valores
# ══════════════════════════════════════════════════════

# Supabase — Encontrás estos valores en:
# Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Vercel — se configuran automáticamente al conectar el proyecto
# No necesitás agregarlas acá
